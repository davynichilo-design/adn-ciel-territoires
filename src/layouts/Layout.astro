---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path?: string;
}

const { title, description, path = '/' } = Astro.props;
const siteName = 'ADN Ciel & Territoires';
const fullTitle = title === siteName ? title : `${title} — ${siteName}`;
const canonicalURL = new URL(path, Astro.site);
const ogImageURL = new URL('/images/hero-photo.webp', Astro.site);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: siteName,
  description:
    "Conseil et présélection d'opérateurs de spectacles de drones pour les collectivités françaises.",
  url: Astro.site?.toString(),
  image: ogImageURL.toString(),
  areaServed: {
    '@type': 'Country',
    name: 'France',
  },
  audience: {
    '@type': 'Audience',
    audienceType: 'Collectivités locales',
  },
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / partage social -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="fr_FR" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Polices : Libre Franklin (titres) + Public Sans (texte courant) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@600;700;800&family=Public+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Données structurées (schema.org) -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a href="#contenu" class="skip-link">Aller au contenu principal</a>
    <Header currentPath={path} />
    <main id="contenu">
      <slot />
    </main>
    <Footer />
  </body>
</html>
