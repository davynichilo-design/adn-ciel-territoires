---
interface Props {
  currentPath: string;
}
const { currentPath } = Astro.props;

const links = [
  { href: '/', label: 'Accueil' },
  { href: '/accompagnement-collectivites/', label: 'Conseil à la décision' },
  { href: '/methode-engagements/', label: 'Méthode et engagements' },
  { href: '/a-propos/', label: 'À propos' },
];

const isCurrent = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="site-header">
  <a
    href="/accompagnement-collectivites/"
    class="offer-banner"
    aria-label="Offre de lancement 2026 : abonnement annuel à 490 € HT, pour le 14 juillet et le Nouvel An"
  >
    <span class="offer-banner__tag" aria-hidden="true">
      <span class="offer-banner__tag-long">Offre de lancement</span>
      <span class="offer-banner__tag-short">Offre</span> 2026
    </span>
    <span class="offer-banner__viewport" aria-hidden="true">
      <span class="offer-banner__track">
        {[0, 1].map(() => (
          <span class="offer-banner__group">
            {[0, 1, 2].map(() => (
              <span>
                Vos devis de&nbsp;<b>spectacle de drones</b>&nbsp;analysés pour le&nbsp;<b>14&nbsp;juillet</b>&nbsp;et le&nbsp;<b>Nouvel&nbsp;An</b>
                &nbsp;:&nbsp;<b class="offer-banner__price">490&nbsp;€ HT</b>&nbsp;par an
              </span>
            ))}
          </span>
        ))}
      </span>
    </span>
    <span class="offer-banner__cta" aria-hidden="true">Voir l'offre <span>→</span></span>
  </a>
  <div class="container site-header__inner">
    <a href="/" class="brand">
      <svg class="brand__mark" viewBox="0 0 40 44" fill="none" aria-hidden="true">
        <path d="M20 1 38 8v14c0 12-8 18.5-18 21C10 40.5 2 34 2 22V8Z" fill="#1b2a6b" />
        <path d="M20 1 38 8v14c0 12-8 18.5-18 21C10 40.5 2 34 2 22V8Z" stroke="#a9812f" stroke-width="1.2" />
        <text x="20" y="26" font-family="Libre Franklin, sans-serif" font-weight="800" font-size="12" fill="#fff" text-anchor="middle">ADN</text>
      </svg>
      <span class="brand__text">
        <span class="brand__name">ADN Ciel &amp; Territoires</span>
        <span class="brand__baseline">Analyse · Détection · Neutralité</span>
      </span>
    </a>

    <button
      class="nav__toggle"
      id="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
    >
      <span class="visually-hidden">Ouvrir le menu</span>
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M2.5 5h15M2.5 10h15M2.5 15h15" stroke="#1B2A6B" stroke-width="1.6" stroke-linecap="round" />
      </svg>
    </button>

    <nav class="nav" id="site-nav" aria-label="Navigation principale">
      <ul class="nav__list">
        {links.map((link) => (
          <li>
            <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <a href="/contact/" class="button button--primary">Nous écrire</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('site-nav');

  toggle?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
  });

  nav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      nav.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
