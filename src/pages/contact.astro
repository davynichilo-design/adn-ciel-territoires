---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact"
  description="Présentez votre projet de spectacle de drones. La prise de contact ne vaut ni validation de faisabilité, ni engagement contractuel."
  path="/contact/"
>
  <section class="hero" style="padding-block: clamp(2.5rem, 4vw, 4rem);">
    <div class="container container--narrow text-center">
      <p class="badge" style="justify-content: center;">Contact</p>
      <h1>Échanger sur votre projet</h1>
      <p class="lede" style="margin-inline: auto;">
        Décrivez-nous votre projet en quelques lignes : nous revenons vers vous pour évaluer
        ensemble l'accompagnement envisageable.
      </p>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container container--narrow">
      <div class="card" style="padding: clamp(1.5rem, 3vw, 2.5rem);">
      <iframe
        data-tally-src="https://tally.so/embed/KYXOvX?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1&formEventsForwarding=1"
        loading="lazy"
        width="100%"
        height="319"
        frameborder="0"
        marginheight="0"
        marginwidth="0"
        title="ADN Contact"
      ></iframe>
      <script is:inline>
        var d=document,w="https://tally.so/widgets/embed.js",v=function(){"undefined"!=typeof Tally?Tally.loadEmbeds():d.querySelectorAll("iframe[data-tally-src]:not([src])").forEach((function(e){e.src=e.dataset.tallySrc}))};if("undefined"!=typeof Tally)v();else if(d.querySelector('script[src="'+w+'"]')==null){var s=d.createElement("script");s.src=w,s.onload=v,s.onerror=v,d.body.appendChild(s);}
      </script>

      <p class="form-note">
        La prise de contact ne vaut ni validation de faisabilité, ni engagement contractuel.
      </p>
      </div>
    </div>
  </section>
</Layout>
